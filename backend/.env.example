# CRM Cuanty - Variables de entorno backend
# Copiar este archivo a `.env` y rellenar valores. NO commitear `.env`.

# --- Base de datos del CRM (Neon Postgres en prod) ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Chat asistente ---
DEEPSEEK_API_KEY=sk-...

# --- Puerto local (opcional, default 3000) ---
PORT=3001

# --- Integración nocturna con ERP externo ---
# Postgres del ERP en Supabase, SOLO LECTURA.
# Usar el "Transaction pooler" (puerto 6543) para conexiones serverless.
# Obtener en: Supabase project → Settings → Database → Connection string
ERP_DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres

# Token Bearer que valida el handler /api/cron/sync-erp.
# Generar con: `openssl rand -hex 32` o `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`.
# Setear el MISMO valor en:
#   1. Vercel (Project → Settings → Environment Variables)
#   2. GitHub Actions (repo → Settings → Secrets → Actions)
CRON_SECRET=replace_with_random_hex
